{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ESNext"
    ],
    "types": [
      "bun-types",
      "node"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true
  },
  "include": [
    "main.ts",
    "config.ts",
    "menu.ts",
    "log.ts",
    "tray.ts",
    "poll.ts",
    "seed.ts",
    "icon.ts",
    "tests"
  ]
}
