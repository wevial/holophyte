{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TicketDetail",
  "description": "GET /tickets/KEY",
  "$ref": "#/$defs/TicketDetail",
  "$defs": {
    "TicketCriterion": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "text"
      ],
      "additionalProperties": true
    },
    "TicketRevision": {
      "type": "object",
      "properties": {
        "revision": {
          "type": "integer"
        },
        "at": {
          "type": "integer"
        },
        "author": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "body": {
          "type": "string"
        },
        "priority": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "column": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "revision",
        "at",
        "author",
        "title",
        "body",
        "priority",
        "labels",
        "column"
      ],
      "additionalProperties": true
    },
    "ClaimedSnapshot": {
      "type": "object",
      "properties": {
        "revision": {
          "type": "null"
        },
        "title": {
          "type": "string"
        },
        "acceptance_criteria": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "verification_commands": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "revision",
        "title",
        "acceptance_criteria",
        "verification_commands"
      ],
      "additionalProperties": true
    },
    "RevisionStamp": {
      "type": "object",
      "properties": {
        "revision": {
          "type": "integer"
        },
        "at": {
          "type": "integer"
        },
        "author": {
          "type": "string"
        }
      },
      "required": [
        "revision",
        "at",
        "author"
      ],
      "additionalProperties": true
    },
    "TicketNote": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer"
        },
        "at": {
          "type": "integer"
        },
        "author": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "posted_ms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "post_error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "at",
        "author",
        "kind",
        "text",
        "posted_ms",
        "post_error"
      ],
      "additionalProperties": true
    },
    "TicketRun": {
      "type": "object",
      "properties": {
        "run": {
          "type": "integer"
        },
        "attempt": {
          "type": "integer"
        },
        "phase": {
          "type": "string"
        },
        "outcome": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "rounds": {
          "type": "integer"
        },
        "pr_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "started_ms": {
          "type": "integer"
        },
        "ended_ms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "run",
        "attempt",
        "phase",
        "outcome",
        "rounds",
        "pr_url",
        "started_ms",
        "ended_ms"
      ],
      "additionalProperties": true
    },
    "TicketSteer": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer"
        },
        "kind": {
          "enum": [
            "amendment",
            "hint"
          ]
        },
        "note": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "at": {
          "type": "integer"
        },
        "run": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "read_by": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "read_ms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "withdrawn": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "kind",
        "note",
        "author",
        "at",
        "run",
        "read_by",
        "read_ms",
        "withdrawn"
      ],
      "additionalProperties": true
    },
    "TicketDetail": {
      "type": "object",
      "properties": {
        "ticket": {
          "type": "string"
        },
        "ticket_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "title": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "body": {
          "type": "string"
        },
        "acceptance_criteria": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "criteria": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TicketCriterion"
          }
        },
        "verification_commands": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "time_box_ms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "run": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "mirrored_ms": {
          "type": "integer"
        },
        "current": {
          "anyOf": [
            {
              "$ref": "#/$defs/TicketRevision"
            },
            {
              "type": "null"
            }
          ]
        },
        "claimed": {
          "anyOf": [
            {
              "$ref": "#/$defs/TicketRevision"
            },
            {
              "$ref": "#/$defs/ClaimedSnapshot"
            },
            {
              "type": "null"
            }
          ]
        },
        "revisions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RevisionStamp"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TicketNote"
          }
        },
        "runs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TicketRun"
          }
        },
        "steers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TicketSteer"
          }
        }
      },
      "required": [
        "ticket",
        "ticket_url",
        "title",
        "status",
        "body",
        "acceptance_criteria",
        "criteria",
        "verification_commands",
        "time_box_ms",
        "run",
        "mirrored_ms",
        "current",
        "claimed",
        "revisions",
        "notes",
        "runs",
        "steers"
      ],
      "additionalProperties": true
    }
  }
}
