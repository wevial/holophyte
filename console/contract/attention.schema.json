      "type": "object",
      "properties": {
        "level": {
          "enum": [
            "attention",
            "working",
            "none"
          ]
        },
        "items": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/BlockedItem"
              },
              {
                "$ref": "#/$defs/PrOpenItem"
              },
              {
                "$ref": "#/$defs/PausedItem"
              },
              {
                "$ref": "#/$defs/StaleRunItem"
              },
              {
                "$ref": "#/$defs/FailedItem"
              },
              {
                "$ref": "#/$defs/StuckWaitItem"
              },
              {
                "$ref": "#/$defs/SupervisorItem"
              }
            ]
          }
        },
