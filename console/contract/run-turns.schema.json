{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RunTurns",
  "description": "GET /runs/N/turns",
  "$ref": "#/$defs/RunTurns",
  "$defs": {
    "RunTurn": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer"
        },
        "role": {
          "enum": [
            "implement",
            "review",
            "adjudicate",
            "write",
            "trim"
          ]
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "route": {
          "enum": [
            "primary",
            "fallback"
          ]
        },
        "seconds": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "session_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "ended_ms": {
          "type": "integer"
        },
        "exit_status": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "timed_out": {
          "type": "boolean"
        },
        "input_tokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "output_tokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "cost_usd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "role",
        "label",
        "route",
        "seconds",
        "session_id",
        "ended_ms",
        "exit_status",
        "timed_out",
        "input_tokens",
        "output_tokens",
        "cost_usd"
      ],
      "additionalProperties": true
    },
    "RunTurns": {
      "type": "object",
      "properties": {
        "turns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RunTurn"
          }
        }
      },
      "required": [
        "turns"
      ],
      "additionalProperties": true
    }
  }
}
