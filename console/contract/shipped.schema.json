        "pr_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "host": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "ticket",
        "ticket_url",
        "title",
        "rounds",
        "findings",
        "started_ms",
        "actual_min",
        "working_ms",
        "agent_ms",
        "verify_ms",
        "run_count",
        "ended_ms",
        "wall_min",
        "turn_count",
        "estimate_min",
        "merge_sha",
        "commit_url",
        "outcome",
        "outcome_reason",
        "pr_url",
        "host"
      ],
      "additionalProperties": true
    },
    "Shipped": {
      "type": "object",
      "properties": {
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ShippedRow"
          }
        },
        "next_before": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "limit": {
          "type": "integer"
        }
      },
      "required": [
        "rows",
        "next_before",
        "limit"
      ],
      "additionalProperties": true
    }
