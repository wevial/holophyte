{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Shipped",
  "description": "GET /shipped",
  "$ref": "#/$defs/Shipped",
  "$defs": {
    "ShippedRow": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer"
