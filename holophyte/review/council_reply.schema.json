{
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "score", "criteria", "findings", "follow_ups",
               "scope", "refuted"],
  "properties": {
    "verdict": {"type": "string", "enum": ["APPROVE", "REQUEST_CHANGES"]},
    "score": {"type": "integer", "minimum": 0, "maximum": 10},
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "reason", "witness"],
        "properties": {
          "id": {"type": "string"},
          "status": {"type": "string", "enum": ["met", "not_met", "unwitnessed"]},
          "reason": {"type": "string"},
          "witness": {"type": ["string", "null"]}
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "line", "severity", "category", "target", "message"],
        "properties": {
          "path": {"type": ["string", "null"]},
          "line": {"type": ["integer", "null"]},
          "severity": {"type": "string", "enum": ["p0", "p1", "p2"]},
          "category": {
            "type": "string",
            "enum": ["correctness", "security", "tests", "performance",
                     "maintainability", "docs"]
          },
          "target": {"type": "string", "enum": ["code", "description"]},
          "message": {"type": "string"}
        }
      }
    },
    "follow_ups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "text", "path", "line"],
        "properties": {
          "kind": {"type": "string", "enum": ["feature", "guardrail"]},
          "text": {"type": "string"},
          "path": {"type": ["string", "null"]},
          "line": {"type": ["integer", "null"]}
        }
      }
    },
    "scope": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "status", "reason"],
        "properties": {
          "path": {"type": "string"},
          "status": {"type": "string", "enum": ["needed", "tangent"]},
          "reason": {"type": "string"}
        }
      }
    },
    "refuted": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["finding", "reason"],
        "properties": {
          "finding": {"type": "string"},
          "reason": {"type": "string"}
        }
      }
    }
  }
}
